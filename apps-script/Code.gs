/** Tetapkan SPREADSHEET_ID, FOLDER_ID, ALLOWED_EMAILS pada Script Properties. */
function doGet(e){
 authorize_();
 if(e&&e.parameter.mode==='bridge'){
  const origin=String(e.parameter.origin||'');
  const allowed=['https://educreatorsystem.github.io','https://koko-taman-daya-yani.g-52033830.chatgpt.site'];
  if(allowed.indexOf(origin)<0)throw new Error('Origin laman tidak dibenarkan.');
  const nonce=String(e.parameter.nonce||'');if(!/^[a-f0-9-]{36}$/.test(nonce))throw new Error('Sesi tidak sah.');
  const t=HtmlService.createTemplateFromFile('Bridge');t.clientOrigin=origin;t.clientNonce=nonce;
  return t.evaluate().setTitle('Sambungan KOKO').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
 }
 return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('OPR KOKURIKULUM SK TAMAN RINTING 3');
}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function authorize_(){const p=PropertiesService.getScriptProperties();const email=Session.getActiveUser().getEmail().toLowerCase();const allowed=(p.getProperty('ALLOWED_EMAILS')||'').toLowerCase().split(',').map(s=>s.trim());if(!email||allowed.indexOf(email)<0)throw new Error('Akses ditolak. Gunakan akaun guru yang disenaraikan pentadbir.');return email;}
function db_(){const id=(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')||'1_Vtfr2HRBPBGnnTf0Ku2SNMVGDRQy_NQMW1TTHN-JZc');if(!id)throw new Error('SPREADSHEET_ID belum ditetapkan.');return SpreadsheetApp.openById(id);}
const HEADERS={Pertandingan:['ID','Versi','TarikhKemaskini','GuruEmel','DataJSON'],Peserta:['IDPertandingan','IDMurid','Nama','Tahun','Kelas','Jantina','Pencapaian','Catatan'],Guru:['IDPertandingan','Nama'],Lampiran:['IDPertandingan','Jenis','Nama','URL','Kapsyen']};
function setup(){authorize_();const db=db_();Object.keys(HEADERS).forEach(n=>{let sh=db.getSheetByName(n)||db.insertSheet(n);if(!sh.getLastRow())sh.appendRow(HEADERS[n]);sh.setFrozenRows(1);});}
function safe_(x){const s=String(x==null?'':x);return /^[=+@-]/.test(s)?"'"+s:s;}
function upload_(f){if(!f||!f.data)return f;const m=f.data.match(/^data:(image\/(?:jpeg|png|webp)|application\/pdf);base64,([A-Za-z0-9+/=]+)$/);if(!m)throw new Error('Format lampiran tidak sah.');const bytes=Utilities.base64Decode(m[2]);if(bytes.length>(m[1]==='application/pdf'?5:2)*1024*1024)throw new Error('Lampiran melebihi had saiz.');const folder=PropertiesService.getScriptProperties().getProperty('FOLDER_ID');if(!folder)throw new Error('FOLDER_ID belum ditetapkan.');const file=DriveApp.getFolderById(folder).createFile(Utilities.newBlob(bytes,m[1],f.name||'Lampiran'));return {name:f.name,caption:f.caption||'',url:file.getUrl(),fileId:file.getId()};}
function api(req){let lock;try{const email=authorize_();const db=db_();const sh=db.getSheetByName('Pertandingan');if(!sh)throw new Error('Jalankan setup dahulu.');if(req.action==='list'){const rows=sh.getDataRange().getValues().slice(1);return {ok:true,data:rows.filter(r=>r[0]).map(r=>JSON.parse(r[4]))};}lock=LockService.getScriptLock();lock.waitLock(30000);const rows=sh.getDataRange().getValues();const id=req.action==='save'?req.record.id:req.id;const idx=rows.findIndex((r,i)=>i>0&&String(r[0])===id);if(req.action==='delete'){if(idx<1)throw new Error('Rekod tidak ditemui.');sh.deleteRow(idx+1);syncChildren_(db,id,null);return {ok:true,data:true};}if(req.action!=='save')throw new Error('Tindakan tidak sah.');let r=req.record;if(!r||!r.id||!r.name||!r.start||!r.end||!r.reporter||!r.organizer||!r.venue||!r.unit)throw new Error('Maklumat wajib tidak lengkap.');if(r.end<r.start)throw new Error('Tarikh tidak sah.');if(!r.participants||!r.participants.length)throw new Error('Peserta diperlukan.');const ids=r.participants.map(p=>String(p.sid||'').trim().toLowerCase());if(ids.some(x=>!x)||new Set(ids).size!==ids.length||r.participants.some(p=>!p.name))throw new Error('ID dan nama peserta mesti lengkap serta unik.');if((r.images||[]).length>3)throw new Error('Maksimum 3 gambar.');if(idx>0&&Number(rows[idx][1])!==Number(r.version||0))throw new Error('Rekod telah berubah. Muat semula sebelum mengedit.');r.images=(r.images||[]).map(upload_);if(r.attachment)r.attachment=upload_(r.attachment);r.version=(idx>0?Number(rows[idx][1]):0)+1;const json=JSON.stringify(r);if(json.length>48000)throw new Error('Laporan terlalu panjang. Pendekkan teks atau bilangan peserta.');const values=[r.id,r.version,new Date(),email,json];sh.getRange(idx>0?idx+1:sh.getLastRow()+1,1,1,5).setValues([values]);syncChildren_(db,r.id,r);SpreadsheetApp.flush();return {ok:true,data:r};}catch(e){return {ok:false,error:e.message};}finally{if(lock)lock.releaseLock();}}
function syncChildren_(db,id,r){['Peserta','Guru','Lampiran'].forEach(n=>{const s=db.getSheetByName(n);if(!s)return;const values=s.getDataRange().getValues();for(let i=values.length-1;i>0;i--)if(String(values[i][0])===id)s.deleteRow(i+1);});if(!r)return;const append=(n,rs)=>{if(rs.length){const s=db.getSheetByName(n);s.getRange(s.getLastRow()+1,1,rs.length,rs[0].length).setValues(rs.map(row=>row.map(safe_)));}};append('Peserta',r.participants.map(p=>[id,p.sid,p.name,p.year,p.class,p.gender,p.award,p.note]));append('Guru',(r.teachers||'').split('\n').filter(Boolean).map(n=>[id,n]));append('Lampiran',(r.images||[]).map(f=>[id,'Gambar',f.name,f.url,f.caption]).concat(r.attachment?[[id,'PDF',r.attachment.name,r.attachment.url,'']]:[]));}
